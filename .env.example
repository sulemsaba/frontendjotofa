# Public API base URL (FastAPI backend, served by the shared backend repo)
# Local dev:  http://localhost:8000/api
# Production: https://api.your-domain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# WhatsApp float button number (used by src/components/whatsapp-button.tsx, if present)
# NEXT_PUBLIC_WHATSAPP_NUMBER=+255700000000

# Site URL — used for sitemap, RSS feed, JSON-LD canonical URLs
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
